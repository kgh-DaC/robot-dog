+// "I2CSCL <pin>": move the I2C clock to another pin, save it and look for the
+// sensor again. Blocks ~200 ms; processCommand() only runs it while nothing can move.
+const char *imuSetSclPin(uint8_t pin)
+{
+  if (!imuSclPinAllowed(pin)) return "pin_not_allowed_USE_22_19_23_32_33";
+  Preferences store;
+  if (!store.begin("imuCal", false)) return "flash_error";
+  const bool ok = store.putUChar("scl", pin) == 1;
+  store.end();
+  if (!ok) return "flash_error";
+  Wire.end();
+  pinMode(imuSclPin, INPUT);
+  imuSclPin = pin;
+  Wire.begin(IMU_SDA_PIN, imuSclPin, 400000);
   Wire.setTimeOut(10);
+  imuProbeAndInit();
+  return NULL;
